    "Space around snapped windows and between neighbours.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerleştirilen pencerelerin çevresindeki ve aralarındaki boşluk."
          }
        }
      }
    },
    "Start Tessera automatically when you log in.": {
      "localizations": {
