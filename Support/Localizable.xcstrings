      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yok"
          }
        }
      }
    },
    "Off": {
      "comment": "Move and resize from anywhere: off",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı"
          }
        }
      }
    },
    "One large window at a time; swipe sideways on a Magic Mouse or trackpad.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir seferde tek büyük pencere; Magic Mouse veya trackpad'de yana kaydırın."
          }
        }
      }
    },
    "Open Desktop & Dock…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masaüstü ve Dock'u Aç…"
          }
        }
      }
    },
    "Open Login Items…": {
      "localizations": {
        "tr": {
          "stringUnit": {
