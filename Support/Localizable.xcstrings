    "Bring All to Front": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tümünü Öne Getir"
          }
        }
      }
    },
    "Center": {
      "comment": "Window action",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortala"
          }
        }
