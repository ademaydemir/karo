    "Window": {
      "comment": "Menu bar menu",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencere"
          }
        }
      }
    },
    "macOS tiling is also on": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS döşemesi de açık"
          }
        }
      }
    },
    "“Drag windows to screen edges to tile” reacts to the same drags. Turn it off so only Tessera snaps.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS'un “Pencereleri döşemek için ekran kenarlarına sürükle” ayarı aynı sürüklemelere tepki verir. Yalnızca Tessera'nın yerleştirmesi için bu ayarı kapatın."
          }
        }
      }
    }
  },
  "version": "1.0"
}
