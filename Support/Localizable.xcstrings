            "value": "Sağ Üst"
          }
        }
      }
    },
    "Type a shortcut, or press Escape to cancel": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kısayola basın veya vazgeçmek için Escape tuşuna basın"
