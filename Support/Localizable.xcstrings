    "Right-click": {
      "comment": "Mouse action in a hint",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağ tık"
          }
        }
      }
    },
    "Right-click a window in the switcher to close, minimize, hide or place it. Holding ⌥, the same works from the keyboard.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencere değiştiricide bir pencereye sağ tıklayarak onu kapatın, küçültün, gizleyin veya yerleştirin. ⌥ basılıyken aynı işlemler klavyeyle de yapılabilir."
          }
        }
      }
    },
    "Screen Recording needed": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran Kaydı izni gerekli"
          }
        }
      }
    },
    "Settings…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar…"
          }
        }
      }
    },
    "Shortcuts": {
      "comment": "Settings tab",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısayollar"
          }
        }
      }
    },
    "Shortcuts need ⌃, ⌥ or ⌘.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısayollar ⌃, ⌥ veya ⌘ içermelidir."
          }
        }
      }
    },
    "Show All": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tümünü Göster"
          }
        }
      }
    },
    "Show a thumbnail of each window instead of only its app icon.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca uygulama simgesi yerine her pencerenin küçük bir önizlemesini gösterir."
          }
        }
