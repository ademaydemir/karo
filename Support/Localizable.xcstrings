            "state": "translated",
            "value": "Gizlilik Ayarlarını Aç…"
          }
        }
      }
    },
    "Press Esc or click elsewhere to skip.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmek için Esc'e basın veya başka bir yere tıklayın."
          }
        }
      }
    },
    "Preview of the selected style": {
