{
  "sourceLanguage": "en",
  "strings": {
    "%@ is already used by %@.": {
      "comment": "Shortcut conflict: the shortcut, then the action already using it",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is already used by %2$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zaten %2$@ için kullanılıyor."
          }
        }
      }
    },
    "%@ is used by the window switcher.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pencere değiştirici tarafından kullanılıyor."
          }
        }
      }
    },
    "%lld points": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld nokta"
          }
        }
      }
    },
    "%lld pt": {
      "comment": "Slider value in points",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pt"
          }
        }
      }
    },
    "About Tessera": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera Hakkında"
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik"
          }
        }
      }
    },
    "Accessibility access granted": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik izni verildi"
          }
        }
      }
    },
    "Accessibility access required": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik izni gerekli"
          }
        }
      }
    },
    "Allow Tessera in System Settings to finish turning this on.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açmayı tamamlamak için Sistem Ayarları'nda Tessera'ya izin verin."
          }
        }
      }
    },
    "Allow Tessera under Screen & System Audio Recording, then quit and reopen Tessera. Until then, app icons are shown.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran ve Sistem Sesi Kaydı bölümünde Tessera'ya izin verin, ardından Tessera'yı kapatıp yeniden açın. O zamana kadar uygulama simgeleri gösterilir."
          }
        }
      }
    },
    "Allowed": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin verildi"
          }
        }
      }
    },
    "Approval needed": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onay gerekiyor"
          }
        }
      }
    },
    "Bottom Half": {
      "comment": "Window action",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt Yarı"
