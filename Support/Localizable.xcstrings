    "Restore Defaults": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılanlara Döndür"
          }
        }
      }
    },
    "Right": {
      "comment": "Radial menu: right half",
      "localizations": {
        "tr": {
