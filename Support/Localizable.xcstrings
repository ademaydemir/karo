      "comment": "Settings tab",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısayollar"
          }
        }
      }
    },
    "Shortcuts need ⌃, ⌥ or ⌘.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısayollar ⌃, ⌥ veya ⌘ içermelidir."
          }
        }
      }
    },
    "Show All": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tümünü Göster"
          }
        }
      }
    },
    "Show a thumbnail of each window instead of only its app icon.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca uygulama simgesi yerine her pencerenin küçük bir önizlemesini gösterir."
          }
        }
      }
    },
    "Show window previews": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencere önizlemelerini göster"
          }
        }
      }
    },
    "Size": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boyut"
          }
        }
      }
    },
