{
  "sourceLanguage": "en",
  "strings": {
    "%@ is already used by %@.": {
      "comment": "Shortcut conflict: the shortcut, then the action already using it",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is already used by %2$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zaten %2$@ için kullanılıyor."
          }
        }
      }
    },
    "%@ is used by the window switcher.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pencere değiştirici tarafından kullanılıyor."
          }
        }
      }
    },
    "%lld points": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld nokta"
          }
        }
      }
    },
    "%lld pt": {
      "comment": "Slider value in points",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pt"
          }
        }
      }
    },
    "About Karo": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karo Hakkında"
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik"
          }
        }
      }
    },
    "Accessibility access granted": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik izni verildi"
          }
        }
      }
    },
    "Accessibility access required": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik izni gerekli"
          }
        }
      }
    },
    "After snapping to a half or a third, pick a window to fill the rest of the screen.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir pencereyi yarıya veya üçte bire yerleştirdikten sonra ekranın kalanını dolduracak pencereyi seçin."
          }
        }
      }
    },
    "All windows at once; an app’s windows share one deck.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm pencereler bir arada; bir uygulamanın pencereleri tek destede."
          }
        }
      }
    },
    "Allow Karo in System Settings to finish turning this on.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açmayı tamamlamak için Sistem Ayarları'nda Karo'ya izin verin."
          }
        }
      }
    },
    "Allow Karo under Screen & System Audio Recording, then quit and reopen Karo. Until then, app icons are shown.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran ve Sistem Sesi Kaydı bölümünde Karo'ya izin verin, ardından Karo'yu kapatıp yeniden açın. O zamana kadar uygulama simgeleri gösterilir."
          }
        }
      }
    },
    "Allowed": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin verildi"
          }
        }
      }
    },
    "Also %@ / %@ while the switcher is open.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Also %1$@ / %2$@ while the switcher is open."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değiştirici açıkken %1$@ / %2$@ ile de değişir."
          }
        }
      }
    },
    "Approval needed": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onay gerekiyor"
          }
        }
      }
    },
    "Bottom Half": {
      "comment": "Window action",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt Yarı"
          }
        }
      }
    },
    "Bottom Left": {
      "comment": "Window action",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sol Alt"
          }
        }
      }
    },
    "Bottom Right": {
      "comment": "Window action",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağ Alt"
          }
        }
      }
    },
    "Bring All to Front": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tümünü Öne Getir"
          }
        }
      }
    },
    "Center": {
      "comment": "Window action",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortala"
          }
        }
      }
    },
    "Center Third": {
      "comment": "Window action",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orta Üçte Bir"
          }
        }
      }
    },
    "Choose a window for this side": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu taraf için bir pencere seçin"
          }
        }
      }
    },
    "Click a shortcut, then type the new combination. Press ⎋ to cancel.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kısayola tıklayın, ardından yeni tuş birleşimine basın. Vazgeçmek için ⎋ tuşuna basın."
          }
        }
      }
    },
    "Close": {
      "comment": "Close the window",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapat"
          }
        }
      }
    },
    "Corner size": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Köşe boyutu"
          }
        }
      }
    },
    "Could not change the login item: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş öğesi değiştirilemedi: %@"
          }
        }
      }
    },
    "Display": {
      "comment": "Radial menu: move to next display",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran"
          }
        }
      }
    },
    "Displays": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranlar"
          }
        }
      }
    },
    "Drag to Snap": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürükleyerek Yerleştir"
          }
        }
      }
    },
    "Edge sensitivity": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenar hassasiyeti"
          }
        }
      }
    },
    "Edges snap to halves, corners to quarters, the top edge maximizes. Hold ⇧ while dragging to move freely.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenarlar yarıma, köşeler çeyreğe yerleştirir, üst kenar pencereyi büyütür. Serbestçe taşımak için sürüklerken ⇧ tuşunu basılı tutun."
          }
        }
      }
    },
    "Gap between windows": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencereler arası boşluk"
          }
        }
      }
    },
    "General": {
      "comment": "Settings tab",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genel"
          }
        }
      }
    },
    "Grant Accessibility Access…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik İzni Ver…"
          }
        }
      }
    },
    "Grid": {
      "comment": "Switcher style",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izgara"
          }
        }
      }
    },
    "Halves": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarılar"
          }
        }
      }
    },
    "Hide": {
      "comment": "Radial menu: hide the app",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizle"
          }
        }
      }
    },
    "Hide App": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı Gizle"
          }
        }
      }
    },
    "Hide Karo": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karo'yu Gizle"
          }
        }
      }
    },
    "Hide Others": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğerlerini Gizle"
          }
        }
      }
    },
    "Hold these keys and drag anywhere in a window to move it, or right-drag to resize it from the nearest corner.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tuşları basılı tutup pencerenin herhangi bir yerinden sürükleyerek taşıyın veya sağ tıkla sürükleyerek en yakın köşesinden boyutlandırın."
          }
        }
      }
    },
    "Hold ⌥ and press Tab to step through windows; release ⌥ to switch.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencereler arasında ilerlemek için ⌥ tuşunu basılı tutup Tab'a basın; geçiş yapmak için ⌥ tuşunu bırakın."
          }
        }
      }
    },
    "How close to the edge the pointer must be.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmlecin kenara ne kadar yaklaşması gerektiği."
          }
        }
      }
    },
    "Karo can use a different language than macOS.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karo, macOS'tan farklı bir dil kullanabilir."
          }
        }
      }
    },
    "Language": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dil"
          }
        }
      }
    },
