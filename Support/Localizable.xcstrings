{
  "sourceLanguage": "en",
  "strings": {
    "%@ is already used by %@.": {
      "comment": "Shortcut conflict: the shortcut, then the action already using it",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is already used by %2$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zaten %2$@ için kullanılıyor."
          }
        }
      }
    },
    "%@ is used by the window switcher.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pencere değiştirici tarafından kullanılıyor."
          }
        }
      }
    },
    "%lld points": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld nokta"
          }
        }
      }
    },
    "%lld pt": {
      "comment": "Slider value in points",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pt"
          }
        }
      }
    },
    "About Karo": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karo Hakkında"
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik"
          }
        }
      }
    },
    "Accessibility access granted": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik izni verildi"
          }
        }
      }
    },
    "Accessibility access required": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik izni gerekli"
          }
        }
      }
    },
    "After allowing it, restart Karo to see window previews.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin verdikten sonra önizlemeleri görmek için Karo’yu yeniden başlatın."
          }
        }
      }
    },
    "After snapping to a half or a third, pick a window to fill the rest of the screen.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir pencereyi yarıya veya üçte bire yerleştirdikten sonra ekranın kalanını dolduracak pencereyi seçin."
          }
        }
      }
    },
    "All windows at once; an app’s windows share one deck.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm pencereler bir arada; bir uygulamanın pencereleri tek destede."
          }
        }
      }
    },
    "Allow Access": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişime İzin Verin"
          }
        }
      }
    },
    "Allow Karo in System Settings to finish turning this on.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açmayı tamamlamak için Sistem Ayarları'nda Karo'ya izin verin."
          }
        }
      }
    },
    "Allow Karo under Screen & System Audio Recording, then quit and reopen Karo. Until then, app icons are shown.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran ve Sistem Sesi Kaydı bölümünde Karo'ya izin verin, ardından Karo'yu kapatıp yeniden açın. O zamana kadar uygulama simgeleri gösterilir."
          }
        }
      }
    },
    "Allowed": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin verildi"
          }
        }
      }
    },
    "Allow…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin Ver…"
          }
        }
      }
    },
    "Also %@ / %@ while the switcher is open.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Also %1$@ / %2$@ while the switcher is open."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değiştirici açıkken %1$@ / %2$@ ile de değişir."
          }
        }
      }
    },
    "Approval needed": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onay gerekiyor"
          }
        }
      }
    },
    "Apps that are still open after their last window was closed come last. Choose one to open a new window.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son penceresi kapatıldığı hâlde açık olan uygulamalar en sonda görünür. Birini seçince yeni bir pencere açılır."
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri"
          }
        }
      }
    },
    "Bottom Half": {
      "comment": "Window action",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt Yarı"
          }
        }
      }
    },
    "Bottom Left": {
      "comment": "Window action",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sol Alt"
          }
        }
      }
    },
    "Bottom Right": {
      "comment": "Window action",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağ Alt"
          }
        }
      }
    },
    "Bring All to Front": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tümünü Öne Getir"
          }
        }
      }
    },
    "Center": {
      "comment": "Window action",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortala"
          }
        }
      }
    },
    "Center Third": {
      "comment": "Window action",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orta Üçte Bir"
          }
        }
      }
    },
    "Check Now": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi Denetle"
          }
        }
      }
    },
    "Check for Updates…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncellemeleri Denetle…"
          }
        }
      }
    },
    "Check for updates automatically": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncellemeleri otomatik olarak denetle"
          }
        }
      }
    },
    "Choose a Switcher Style": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değiştirici Stilini Seçin"
          }
        }
      }
    },
    "Choose a window for this side": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu taraf için bir pencere seçin"
          }
        }
      }
    },
    "Click a shortcut, then type the new combination. Press ⎋ to cancel.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kısayola tıklayın, ardından yeni tuş birleşimine basın. Vazgeçmek için ⎋ tuşuna basın."
          }
        }
      }
    },
    "Close": {
      "comment": "Close the window",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapat"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam"
          }
        }
      }
    },
    "Corner size": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Köşe boyutu"
          }
        }
      }
    },
    "Could not change the login item: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş öğesi değiştirilemedi: %@"
          }
        }
      }
    },
    "Display": {
      "comment": "Radial menu: move to next display",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran"
          }
        }
      }
    },
    "Displays": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranlar"
          }
        }
      }
    },
    "Do Not Move": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşıma"
          }
        }
      }
    },
    "Do not ask again": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir daha sorma"
          }
        }
      }
    },
    "Dock": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock"
          }
        }
      }
    },
    "Drag Karo to the Applications folder in Finder, then open it from there.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karo'yu Finder'da Uygulamalar klasörüne sürükleyin ve oradan açın."
          }
        }
      }
    },
    "Drag a window to a screen edge or corner to fill a half or a quarter. Karo then suggests windows for the free space.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir pencereyi ekranın kenarına ya da köşesine sürükleyerek yarıya veya çeyreğe yerleştirin. Karo kalan alan için pencere önerir."
          }
        }
      }
    },
    "Drag to Snap": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürükleyerek Yerleştir"
          }
        }
      }
    },
    "Drag to snap": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürükleyip yerleştirin"
          }
        }
      }
    },
    "Edge sensitivity": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenar hassasiyeti"
          }
        }
      }
    },
    "Edges snap to halves, corners to quarters, the top edge maximizes. Hold ⇧ while dragging to move freely.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenarlar yarıma, köşeler çeyreğe yerleştirir, üst kenar pencereyi büyütür. Serbestçe taşımak için sürüklerken ⇧ tuşunu basılı tutun."
          }
        }
      }
    },
    "Gap between windows": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencereler arası boşluk"
          }
        }
      }
    },
    "General": {
      "comment": "Settings tab",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genel"
          }
        }
      }
    },
    "Get Started": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlayın"
          }
        }
      }
    },
    "Grant Accessibility Access…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik İzni Ver…"
          }
        }
      }
    },
    "Grid": {
      "comment": "Switcher style",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izgara"
          }
        }
      }
    },
    "Halves": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarılar"
          }
        }
      }
    },
    "Hide": {
      "comment": "Radial menu: hide the app",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizle"
          }
        }
      }
    },
    "Hide App": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı Gizle"
          }
        }
      }
    },
    "Hide Karo": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karo'yu Gizle"
          }
        }
      }
    },
    "Hide Others": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğerlerini Gizle"
          }
        }
      }
    },
    "Hold %@ and press Tab to step through windows; release %@ to switch.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Hold %1$@ and press Tab to step through windows; release %2$@ to switch."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencereler arasında ilerlemek için %1$@ tuşunu basılı tutup Tab'a basın; geçiş yapmak için %1$@ tuşunu bırakın."
          }
        }
      }
    },
    "Hold these keys and drag anywhere in a window to move it, or right-drag to resize it from the nearest corner.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tuşları basılı tutup pencerenin herhangi bir yerinden sürükleyerek taşıyın veya sağ tıkla sürükleyerek en yakın köşesinden boyutlandırın."
          }
        }
      }
    },
    "Hold ⌥ and press Tab to step through windows; release ⌥ to switch.": {
      "extractionState": "stale",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencereler arasında ilerlemek için ⌥ tuşunu basılı tutup Tab'a basın; geçiş yapmak için ⌥ tuşunu bırakın."
          }
        }
      }
    },
    "How close to the edge the pointer must be.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmlecin kenara ne kadar yaklaşması gerektiği."
          }
        }
      }
    },
    "How ⌥ + Tab shows your windows. You can change it later in Settings.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ + Tab pencerelerinizi nasıl göstersin? Bunu daha sonra Ayarlar’da değiştirebilirsiniz."
          }
        }
      }
    },
    "Karo can use a different language than macOS.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karo, macOS'tan farklı bir dil kullanabilir."
          }
        }
      }
    },
    "Karo could not be moved": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karo taşınamadı"
          }
        }
      }
    },
    "Karo is running from outside the Applications folder, for example from the disk image. In Applications it can update itself and start at login.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karo, Uygulamalar klasörünün dışından, örneğin disk imajından çalışıyor. Uygulamalar klasöründe kendini güncelleyebilir ve girişte açılabilir."
          }
        }
      }
    },
    "Karo lives in the menu bar. Click its icon for window actions and Settings.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karo menü çubuğunda çalışır. Pencere işlemleri ve Ayarlar için simgesine tıklayın."
          }
        }
      }
    },
    "Karo looks for a new version once a day and asks before installing it.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karo günde bir kez yeni sürüm arar ve yüklemeden önce size sorar."
          }
        }
      }
    },
    "Karo works through macOS privacy permissions. Everything stays on your Mac.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karo, macOS gizlilik izinleriyle çalışır. Hiçbir veri Mac’inizden çıkmaz."
          }
        }
      }
    },
    "Karo ⌥ + Tab: every window": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karo ⌥ + Tab: her pencere"
          }
        }
      }
    },
    "Language": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dil"
          }
        }
      }
    },
    "Large": {
      "comment": "Switcher size",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük"
          }
        }
      }
    },
    "Launch at login": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum açıldığında başlat"
          }
        }
      }
    },
    "Layout": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerleşim"
          }
        }
      }
    },
    "Left": {
      "comment": "Radial menu: left half",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sol"
          }
        }
      }
    },
    "Left Half": {
      "comment": "Window action",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sol Yarı"
          }
        }
      }
    },
    "Left Third": {
      "comment": "Window action",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sol Üçte Bir"
          }
        }
      }
    },
    "Left Two Thirds": {
      "comment": "Window action",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sol Üçte İki"
          }
        }
      }
    },
    "Length of the corner areas that snap to quarters.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çeyreğe yerleştiren köşe alanlarının uzunluğu."
          }
        }
      }
    },
    "Lets Karo move and resize other apps’ windows.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karo’nun diğer uygulamaların pencerelerini taşıyıp boyutlandırmasını sağlar."
          }
        }
      }
    },
    "List": {
      "comment": "Switcher style",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste"
          }
        }
      }
    },
    "Maximize": {
      "comment": "Window action",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyüt"
          }
        }
      }
    },
    "Medium": {
      "comment": "Switcher size",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orta"
          }
        }
      }
    },
    "Minimize": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçült"
          }
        }
      }
    },
    "Minimized or hidden": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçültülmüş veya gizli"
          }
        }
      }
    },
    "Move Karo to the Applications folder?": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karo, Uygulamalar klasörüne taşınsın mı?"
          }
        }
      }
    },
    "Move Window": {
      "comment": "Menu section header",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencereyi Taşı"
          }
        }
      }
    },
    "Move and Resize": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşıma ve Boyutlandırma"
          }
        }
      }
    },
    "Move and resize from anywhere": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her yerden taşı ve boyutlandır"
          }
        }
      }
    },
    "Move to Applications": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar'a Taşı"
          }
        }
      }
    },
    "Move to Next Display": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki Ekrana Taşı"
          }
        }
      }
    },
    "Next Display": {
      "comment": "Window action",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki Ekran"
          }
        }
      }
    },
    "No windows": {
      "localizations": {
        "tr": {
          "stringUnit": {
