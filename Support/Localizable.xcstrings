      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her yerden taşı ve boyutlandır"
          }
        }
      }
    },
    "Move to Next Display": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
