      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik Ayarlarını Aç…"
          }
        }
      }
    },
    "Point at a window in the switcher to close, minimize, hide or place it. Holding ⌥, the same works from the keyboard.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencere değiştiricide bir pencerenin üzerine gelerek onu kapatın, küçültün, gizleyin veya yerleştirin. ⌥ basılıyken aynı işlemler klavyeyle de yapılabilir."
          }
        }
      }
    },
    "Press %@ or %@ while the switcher is open to change it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Press %1$@ or %2$@ while the switcher is open to change it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencere değiştirici açıkken değiştirmek için %1$@ veya %2$@ tuşlarına basın."
          }
        }
      }
    },
    "Previous Display": {
      "comment": "Window action",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki Ekran"
          }
        }
      }
    },
    "Quick actions": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı işlemler"
          }
        }
      }
    },
    "Quit App": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamadan Çık"
          }
        }
      }
    },
    "Quit Tessera": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera'dan Çık"
          }
        }
      }
    },
