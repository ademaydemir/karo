          "stringUnit": {
            "state": "translated",
            "value": "Seçili görünümün önizlemesi"
          }
        }
      }
    },
    "Previous Display": {
      "comment": "Window action",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki Ekran"
          }
        }
      }
    },
    "Quick actions": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı işlemler"
          }
        }
      }
    },
    "Quit": {
      "comment": "Radial menu: quit the app",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çık"
          }
        }
      }
    },
    "Quit App": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamadan Çık"
          }
        }
      }
    },
    "Quit Karo": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karo'dan Çık"
          }
        }
      }
    },
    "Records a new shortcut": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir kısayol kaydeder"
          }
        }
      }
    },
    "Remember window positions for each display setup": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ekran düzeni için pencere konumlarını hatırla"
          }
        }
      }
    },
    "Remove shortcut": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısayolu kaldır"
          }
        }
      }
    },
    "Required to move and resize other apps’ windows.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer uygulamaların pencerelerini taşımak ve boyutlandırmak için gerekli."
          }
        }
      }
    },
    "Restart Karo to use the new language.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni dili kullanmak için Karo'yu yeniden başlatın."
          }
        }
      }
    },
    "Restart Now": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi Yeniden Başlat"
          }
        }
      }
    },
    "Restore": {
