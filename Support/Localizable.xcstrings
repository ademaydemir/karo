      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçiş"
          }
        }
      }
    },
    "System Default": {
      "comment": "Language option that follows macOS",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Varsayılanı"
          }
        }
      }
    },
    "Tessera can use a different language than macOS.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera, macOS'tan farklı bir dil kullanabilir."
          }
        }
      }
    },
    "Top Half": {
      "comment": "Window action",
      "localizations": {
